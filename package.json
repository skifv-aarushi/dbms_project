{
  "name": "mentor-mentee-management-platform",
  "version": "1.0.0",
  "description": "Institutional Relational DBMS Mentor & Mentee Management Platform with Smart Recommender",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:init": "npm --prefix backend run db:init",
    "db:test-trigger": "npm --prefix backend run db:test-trigger",
    "test:api": "npm --prefix backend run test:api",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "keywords": [
    "postgresql",
    "dbms",
    "3nf",
    "recommender",
    "react",
    "express",
    "vite",
    "mentorship"
  ],
